# ============================================
# ALLUMA PERGAMINO — Variables de entorno (backend)
# Copiar a .env y completar con valores reales.
# ============================================

PORT=3001
NODE_ENV=production

# Base de datos MySQL — usar DATABASE_URL (Railway) o las variables sueltas
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pergamino_crm

JWT_SECRET=cambiar_esto_por_algo_largo_y_random
JWT_EXPIRES_IN=7d

# Dominios del frontend separados por coma
CORS_ORIGIN=

# Webhooks de entrada (bot WhatsApp / Zapier) genéricos
# Formato: proveedor:clave;proveedor2:clave2
LEAD_API_KEYS=

# Bot de WhatsApp con IA (index.js del bot, puerto 3700) — TIENEN que
# coincidir exacto con ZAPIER_KEY y NOTIFY_KEY del .env del bot.
ZAPIER_WEBHOOK_KEY=alluma-zapier-secret-2024
WA_NOTIFY_KEY=alluma-wa-notify-2024

# Cloudinary (usado por scoring para los PDFs de venta) — completar si se usa
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
